{
  "name": "@computerwwwizards/dependency-injection",
  "version": "2.0.3",
  "private": false,
  "type": "module",
  "repository": "https://github.com/computerwwwizards/dependency-injection",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist"
  ],
   "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.19.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.15.0 <25.0.0",
    "npm": ">=11.19.1 <12.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/node": "^26.0.6",
    "typescript": "^7.0.2"
  }
}
