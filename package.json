{
  "name": "@computerwwwwizards/dependency-injection",
  "version": "2.0.0",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
     "url": "https://github.com/computerwwwizards/dependency-injection"
   },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./tutorials": {
      "types": "./dist/tutorials.d.ts",
      "default": "./dist/tutorials.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.23.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "pnpm": ">=12.23.0 <13.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/node": "^26.0.6",
    "typescript": "^7.0.2"
  }
}
